# Export these variables into the shell; Django does not auto-load this file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL required when DJANGO_DEBUG=false
# POSTGRES_DB=biz
# POSTGRES_USER=biz
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Coordonnées réelles à renseigner avant émission commerciale
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_REGISTRATION=
BUSINESS_EMAIL=

# Coordonnées affichées sur la vitrine, distinctes de l'identité comptable
BUSINESS_CONTACT_EMAIL=contact@smartyiriba.org
BUSINESS_CONTACT_SECONDARY_EMAIL=smartyiriba@gmail.com
BUSINESS_CONTACT_PHONE=
# WhatsApp au format international, chiffres uniquement (sans + ni espaces)
BUSINESS_WHATSAPP=
BUSINESS_CONTACT_ADDRESS=Sotuba, Bamako, Mali
BUSINESS_CONTACT_HOURS=09 h à 18 h · jours à confirmer
